# =============================================================================
# FijaPrecio — variables para DESARROLLO LOCAL (docker-compose)
# -----------------------------------------------------------------------------
# Copiar a `.env`:   cp .env.example .env
#
# En Railway NO se usa este archivo: cada servicio define sus variables en el
# dashboard, resolviéndolas con reference variables, p. ej.:
#   DATABASE_URL = ${{Postgres.DATABASE_URL}}
#   REDIS_URL    = ${{Redis.REDIS_URL}}
#   SCRAPER_URL  = http://${{scraper.RAILWAY_PRIVATE_DOMAIN}}:8000
#
# Cada app valida SUS variables al arrancar con @fijaprecio/config-schema
# (Zod, fail-fast). Si falta una requerida, el servicio no levanta.
# =============================================================================

NODE_ENV=development

# --- Postgres (infra/docker-compose.yml) ---
# El contenedor publica en el puerto host 5433 (5432 suele estar ocupado por un
# PostgreSQL nativo). Si cambiaste el mapeo en docker-compose.yml, ajusta aquí.
DATABASE_URL=postgresql://fijaprecio:fijaprecio@localhost:5433/fijaprecio?schema=public
# Rol NOBYPASSRLS para la API (defensa en profundidad — ver packages/db/prisma/README.md).
# En Railway: crear el rol y pasar la reference var del Postgres con ese usuario.
APP_DATABASE_URL=postgresql://fijaprecio_app:fijaprecio_app@localhost:5433/fijaprecio?schema=public
DB_RLS_ENFORCED=false

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO local, S3-compatible; en prod: Cloudflare R2) ---
R2_ENDPOINT=http://localhost:9000
R2_REGION=auto
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET=fijaprecio-dev
R2_PUBLIC_URL=http://localhost:9000/fijaprecio-dev

# --- Búsqueda (Typesense local) ---
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-only-key

# --- API core ---
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_SECRET=change-me-min-32-chars-0000000000000000
JWT_REFRESH_SECRET=change-me-too-min-32-chars-1111111111
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Dominio de la cookie de sesión. Vacío en local (cookie de host).
# En prod: ".fijaprecio.com" para compartir entre app.* y api.*
AUTH_COOKIE_DOMAIN=
# TTL (s) del caché Redis de configuración de negocio. Default 300.
CONFIG_CACHE_TTL_SECONDS=300

# --- Comunicación interna entre servicios ---
INTERNAL_API_TOKEN=dev-internal-token-min-32-chars-22222
SCRAPER_URL=http://localhost:8000
OCR_URL=http://localhost:8001
API_URL=http://localhost:3001
BOT_INTERNAL_URL=http://localhost:3002

# --- Bot de Telegram (opcional en local) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=dev-webhook-secret-min-16
BOT_PORT=3002
BOT_PUBLIC_URL=http://localhost:3002

# --- Worker ---
WORKER_CONCURRENCY=5

# --- Email (opcional en local) ---
RESEND_API_KEY=
EMAIL_FROM=FijaPrecio <no-reply@fijaprecio.local>

# --- Observabilidad (opcional) ---
SENTRY_DSN=
LOG_LEVEL=debug

# --- Defaults de negocio de arranque (solo bootstrap; el resto vive en DB) ---
DEFAULT_CURRENCY=PEN
DEFAULT_LOCALE=es-PE
DEFAULT_TIMEZONE=America/Lima

# --- Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=development
