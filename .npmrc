# pnpm
auto-install-peers=true
strict-peer-dependencies=false
dedupe-peer-dependents=true
# Prisma / NestJS traen binarios y scripts de postinstall:
enable-pre-post-scripts=true
# Paquetes cuyos build scripts se permiten explícitamente (pnpm >= 10):
# se completa la primera vez con `pnpm approve-builds`.
