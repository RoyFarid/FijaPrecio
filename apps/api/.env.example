# apps/api — variables del servicio (ver esquema en @fijaprecio/config-schema/api).
# En Railway se definen en el dashboard del servicio `api`.

NODE_ENV=production
PORT=3001                       # Railway lo inyecta; en local usar API_PORT
API_PUBLIC_URL=https://api.fijaprecio.com
CORS_ORIGINS=https://app.fijaprecio.com

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fijaprecio-prod
R2_PUBLIC_URL=https://cdn.fijaprecio.com

INTERNAL_API_TOKEN=              # compartido con scraper / ocr / worker
SCRAPER_URL=http://${{scraper.RAILWAY_PRIVATE_DOMAIN}}:8000
OCR_URL=http://${{ocr.RAILWAY_PRIVATE_DOMAIN}}:8001

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_COOKIE_DOMAIN=.fijaprecio.com
CONFIG_CACHE_TTL_SECONDS=300

TYPESENSE_URL=http://${{search.RAILWAY_PRIVATE_DOMAIN}}:8108
TYPESENSE_API_KEY=

RESEND_API_KEY=
EMAIL_FROM=FijaPrecio <no-reply@fijaprecio.com>

SENTRY_DSN=
LOG_LEVEL=info

DEFAULT_CURRENCY=PEN
DEFAULT_LOCALE=es-PE
DEFAULT_TIMEZONE=America/Lima
