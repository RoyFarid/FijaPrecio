# apps/bot — ver esquema en @fijaprecio/config-schema/bot.
NODE_ENV=production
PORT=3002                        # Railway lo inyecta; local: BOT_PORT
BOT_PUBLIC_URL=https://bot.fijaprecio.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:3001

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fijaprecio-prod

INTERNAL_API_TOKEN=
SCRAPER_URL=http://${{scraper.RAILWAY_PRIVATE_DOMAIN}}:8000
OCR_URL=http://${{ocr.RAILWAY_PRIVATE_DOMAIN}}:8001

SENTRY_DSN=
LOG_LEVEL=info
