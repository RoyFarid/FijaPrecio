# apps/web — ver esquema en @fijaprecio/config-schema/web.
NODE_ENV=production

# Solo servidor (SSR / route handlers)
API_INTERNAL_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:3001

# Cliente — se inyectan al bundle del navegador (deben ir con prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=https://api.fijaprecio.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SENTRY_DSN=
