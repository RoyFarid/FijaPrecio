# apps/worker — ver esquema en @fijaprecio/config-schema/worker.
NODE_ENV=production
PORT=3010                        # Railway lo inyecta (health); local: WORKER_HEALTH_PORT
WORKER_CONCURRENCY=5

DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}

R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=fijaprecio-prod

INTERNAL_API_TOKEN=
SCRAPER_URL=http://${{scraper.RAILWAY_PRIVATE_DOMAIN}}:8000
OCR_URL=http://${{ocr.RAILWAY_PRIVATE_DOMAIN}}:8001

RESEND_API_KEY=
EMAIL_FROM=FijaPrecio <no-reply@fijaprecio.com>

SENTRY_DSN=
LOG_LEVEL=info
DEFAULT_CURRENCY=PEN
DEFAULT_LOCALE=es-PE
DEFAULT_TIMEZONE=America/Lima
