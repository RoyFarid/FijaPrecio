{
  "name": "fijaprecio",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "pnpm --filter @fijaprecio/db migrate:dev",
    "db:deploy": "pnpm --filter @fijaprecio/db migrate:deploy",
    "db:seed": "pnpm --filter @fijaprecio/db seed",
    "db:studio": "pnpm --filter @fijaprecio/db studio",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "rimraf": "^6.0.1",
    "turbo": "2.10.12",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
