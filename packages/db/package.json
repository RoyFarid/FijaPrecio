{
  "name": "@fijaprecio/db",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts"
  },
  "scripts": {
    "db:generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "dotenv -e ../../.env -- prisma migrate reset",
    "seed": "dotenv -e ../../.env -- prisma db seed",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "lint": "eslint src",
    "clean": "rimraf dist .turbo generated *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/client": "catalog:"
  },
  "devDependencies": {
    "@fijaprecio/eslint-config": "workspace:*",
    "@fijaprecio/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint": "catalog:",
    "prisma": "catalog:",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
