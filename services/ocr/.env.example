# services/ocr — validado por app/config.py (pydantic-settings).
NODE_ENV=development
PORT=8001

INTERNAL_API_TOKEN=dev-internal-token-min-32-chars-22222
OCR_DEFAULT_PROVIDER=tesseract
OCR_TESSERACT_LANG=spa+eng
OCR_MAX_IMAGE_BYTES=12000000
OCR_DOWNLOAD_TIMEOUT_SECONDS=20

# Solo si se activa un provider cloud (adaptadores intercambiables)
AWS_REGION=
GOOGLE_CREDENTIALS_JSON=

LOG_LEVEL=info
SENTRY_DSN=
