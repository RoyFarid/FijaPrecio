# services/scraper — validado por app/config.py (pydantic-settings).
NODE_ENV=production
PORT=8000

API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:3001
INTERNAL_API_TOKEN=

# Opcional: lectura directa de ScrapingSource / cola de jobs
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Proxies rotativos (ScraperAPI / Zyte / Bright Data). Se activan por fuente.
SCRAPER_PROXY_URL=

SCRAPER_SCHEDULER_ENABLED=true
LOG_LEVEL=info
SENTRY_DSN=
