# services/scraper — validado por app/config.py (pydantic-settings).
NODE_ENV=development
PORT=8000

# API core: ingesta de observaciones + lista de insumos a raspar (red privada)
API_URL=http://localhost:3001
INTERNAL_API_TOKEN=dev-internal-token-min-32-chars-22222

# Lectura de ScrapingSource / AppSetting / UnitConversion
DATABASE_URL=postgresql://fijaprecio:fijaprecio@localhost:5433/fijaprecio?schema=public

# Token de la API de MercadoLibre (opcional; sin él el search puede dar 401)
MERCADOLIBRE_ACCESS_TOKEN=

# Proxies rotativos (ScraperAPI / Zyte / Bright Data). Se activan por fuente.
SCRAPER_PROXY_URL=

# --- operativos (no de negocio; los parámetros de negocio están en la DB) ---
SCRAPER_DEFAULT_REGION=PE
DEFAULT_CURRENCY=PEN
SCRAPER_SWEEP_INTERVAL_MINUTES=360
SCRAPER_TARGETS_PER_RUN=50
SCRAPER_REQUEST_TIMEOUT_SECONDS=20
SCRAPER_SCHEDULER_ENABLED=true

LOG_LEVEL=info
SENTRY_DSN=
